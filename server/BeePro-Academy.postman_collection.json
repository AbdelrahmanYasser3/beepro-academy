            "url": "{{baseUrl}}/dashboard/admin"
          }
        },
        {
          "name": "Course analytics",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/analytics/course/{{courseId}}"
          }
        },
        {
          "name": "Teacher analytics",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/analytics/teacher"
          }
        },
        {
          "name": "Admin analytics",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/analytics/admin"
          }
        }
      ]
    },
    {
      "name": "Reports, Payments, Certificates, Profile, Settings",
      "item": [
        {
          "name": "List reports",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/reports?search=&limit=20&offset=0"
          }
        },
        {
          "name": "Get report",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/reports/{{id}}"
          }
        },
        {
          "name": "Export report",
          "request": {
