{
  "info": {
    "name": "BeePro Academy API",
    "_postman_id": "beepro-academy-v1",
    "description": "BeePro Academy API v1 collection. Existing endpoint contracts remain unchanged; modules 6-17 are included here.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000/api/v1" },
    { "key": "token", "value": "" },
    { "key": "courseId", "value": "course-id" },
    { "key": "id", "value": "resource-id" }
  ],
  "item": [
    {
      "name": "Lessons",
      "item": [
        {
          "name": "List course lessons",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/courses/{{courseId}}/lessons"
          }
        },
        {
          "name": "Get lesson",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/lessons/{{id}}"
          }
        },
        {
          "name": "Create lesson",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Introduction\",\n  \"content\": \"Lesson content\"\n}"
            },
            "url": "{{baseUrl}}/courses/{{courseId}}/lessons"
          }
        },
        {
          "name": "Update lesson",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Updated lesson\"\n}"
            },
            "url": "{{baseUrl}}/lessons/{{id}}"
          }
        },
        {
          "name": "Delete lesson",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/lessons/{{id}}"
          }
        }
      ]
    },
    {
      "name": "Enrollments",
      "item": [
        {
          "name": "List enrollments",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/enrollments"
          }
        },
        {
          "name": "Create enrollment",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"courseId\": \"{{courseId}}\"\n}"
            },
            "url": "{{baseUrl}}/enrollments"
          }
        },
        {
          "name": "Delete enrollment",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/enrollments/{{id}}"
          }
        },
        {
          "name": "My courses",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/users/me/courses"
          }
        }
      ]
    },
    {
      "name": "Meetings",
      "item": [
        {
          "name": "List meetings",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/meetings?search=&sortBy=scheduled_at&sortOrder=asc&limit=20&offset=0"
          }
        },
        {
          "name": "Get meeting",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/meetings/{{id}}"
          }
        },
        {
          "name": "Create meeting",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Office hours\",\n  \"scheduled_at\": \"2026-07-22T12:00:00Z\"\n}"
            },
            "url": "{{baseUrl}}/meetings"
          }
        },
        {
          "name": "Update meeting",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"completed\"\n}"
            },
            "url": "{{baseUrl}}/meetings/{{id}}"
          }
        },
        {
          "name": "Delete meeting",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/meetings/{{id}}"
          }
        }
      ]
    },
    {
      "name": "Chat",
      "item": [
        {
          "name": "List chat",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/chat?search=&limit=20&offset=0"
          }
        },
        {
          "name": "Get message",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/chat/{{id}}"
          }
        },
        {
          "name": "Send message",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"receiver_id\": \"user-id\",\n  \"content\": \"Hello\"\n}"
            },
            "url": "{{baseUrl}}/chat"
          }
        },
        {
          "name": "Update message",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"content\": \"Updated message\"\n}"
            },
            "url": "{{baseUrl}}/chat/{{id}}"
          }
        },
        {
          "name": "Delete message",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/chat/{{id}}"
          }
        }
      ]
    },
    {
      "name": "Notifications",
